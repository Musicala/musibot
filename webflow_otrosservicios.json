{
  "name": "Musicala - Otros Servicios (módulo)",
  "type": "botflow",
  "version": "v3.10.7",
  "notes": [
    "Módulo Otros Servicios extraído del flow original.",
    "Referencias al router: show_program_options existe en webflow_router.json.",
