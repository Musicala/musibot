      "type": "filter",
      "position": [1660, 0],
      "parameters": {
        "options": {
          "filterConditions": [
            {
              "operator": "contains",
              "value": "vacacional",
              "targetNodeId": "flow_vacacionales",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            },
            {
              "operator": "contains",
              "value": "presencial",
              "targetNodeId": "flow_presencial",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            },
            {
              "operator": "contains",
              "value": "virtual",
              "targetNodeId": "flow_virtual",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            },
            {
              "operator": "contains",
              "value": "domicilio",
              "targetNodeId": "flow_domicilio",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            },
            {
              "operator": "contains",
              "value": "otros",
              "targetNodeId": "flow_otros_servicios",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            }
          ],
          "filterDefaultCondition": {
            "targetNodeId": "menu_fallback",
            "storeResponseInMemory": true,
            "labelInMemory": "service"
          }
        }
      }
    },
