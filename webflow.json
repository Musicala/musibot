              "labelInMemory": "phone"
            }
          ],
          "filterDefaultCondition": {
            "targetNodeId": "show_program_options",
            "storeResponseInMemory": true,
            "labelInMemory": "phone"
          }
        }
      }
    },

    {
      "id": "show_program_options",
      "name": "05 - Menú opciones (Programas / Modalidades)",
      "type": "autobotAction",
      "position": [1420, 0],
      "parameters": {
        "options": {
          "allowFreeText": false,
          "_flow": { "allowFreeText": false },
          "textMessage": "✨ ¡Descubre nuestras opciones en Música, Danza, Artes Plásticas y Teatro! 🎭🎶🎨\n\n1️⃣ Cursos Vacacionales – Actividades artísticas y divertidas para vacaciones o recesos escolares.\n2️⃣ Clases Presenciales – En nuestra sede, con clases individuales o en grupos pequeños.\n3️⃣ Clases Virtuales – Aprende desde casa con clases en vivo o a tu ritmo por nuestra plataforma.\n4️⃣ Clases a Domicilio – Profes en casa. Llevamos el arte hasta tu puerta. 🏠\n5️⃣ Otros Servicios – Alquiler de espacios, tienda de instrumentos, eventos y más.\n\n💬 ¿Cuál opción te gustaría conocer mejor?",
          "options": [
            "Cursos Vacacionales",
            "Clases Presenciales",
            "Clases Virtuales",
            "Clases a Domicilio",
            "Otros Servicios"
          ],
          "waitResponse": true,
          "typeMessage": "text"
        }
      }
    },
