{
  "name": "Musicala - Router (Intro + Menú servicios)",
  "type": "botflow",
  "version": "v3.10.6",
  "notes": [
    "Router principal: contiene webhook + intro (audio/nombre/teléfono) + menú de servicios.",
    "Los flujos por servicio viven en archivos separados y serán conectados por IDs (flow_vacacionales, flow_presencial, flow_virtual, flow_domicilio, flow_otros_servicios) al hacer merge.",
    "Se conserva exactamente el contenido original. Cambios SOLO de ruteo/conexiones (multi-flow safe).",
    "Importante: se mantienen conexiones duplicadas intencionalmente en nodos con botones para mapear por índice (1 opción = 1 edge)."
  ],
  "nodes": [
    {
      "id": "webhook",
      "name": "webhook node",
      "type": "webhook",
      "position": [0, 0],
      "parameters": { "path": "MUSIBOT" }
    },
    {
      "id": "ask_name",
      "name": "01 - Audio + Pedir nombre",
      "type": "autobotAction",
      "position": [220, 0],
      "parameters": {
        "options": {
          "allowFreeText": true,
          "textMessage": "Gracias por comunicarte con Musicala, escuela de formación artística 🥰🎶💃🏽🎨. Antes de empezar, ¿podrías decirnos tu nombre?",
          "waitResponse": true,
          "typeMessage": "text",
          "options": ["Prefiero no dejarlo"],
          "media": [{ "type": "audio", "url": "assets/introaudio.mp3" }]
        }
      }
    },
    {
      "id": "ask_name_filter",
      "name": "02 - Guardar nombre",
      "type": "filter",
      "position": [700, 0],
      "parameters": {
        "options": {
          "filterConditions": [
            {
              "operator": "contains",
              "value": "prefiero",
              "targetNodeId": "ask_phone",
              "storeResponseInMemory": false,
              "labelInMemory": "name"
            },
            {
              "operator": "always",
              "value": "*",
              "targetNodeId": "ask_phone",
              "storeResponseInMemory": true,
              "labelInMemory": "name"
            }
          ],
          "filterDefaultCondition": {
            "targetNodeId": "ask_phone",
            "storeResponseInMemory": true,
            "labelInMemory": "name"
          }
        }
      }
    },
    {
      "id": "ask_phone",
      "name": "03 - Pedir celular",
      "type": "autobotAction",
      "position": [940, 0],
      "parameters": {
        "options": {
          "allowFreeText": true,
          "textMessage": "Podrías indicarnos ahora, ¿cuál es tu número de celular? (ej: +57 300 123 4567)",
          "waitResponse": true,
          "typeMessage": "text"
        }
      }
    },
    {
      "id": "ask_phone_filter",
      "name": "04 - Guardar celular",
      "type": "filter",
      "position": [1180, 0],
      "parameters": {
        "options": {
          "filterConditions": [
            {
              "operator": "always",
              "value": "*",
              "targetNodeId": "show_program_options",
              "storeResponseInMemory": true,
              "labelInMemory": "phone"
            }
          ],
          "filterDefaultCondition": {
            "targetNodeId": "show_program_options",
            "storeResponseInMemory": true,
            "labelInMemory": "phone"
          }
        }
      }
    },
    {
      "id": "show_program_options",
      "name": "05 - Menú opciones (Programas / Modalidades)",
      "type": "autobotAction",
      "position": [1420, 0],
      "parameters": {
        "options": {
          "allowFreeText": false,
          "textMessage": "✨ ¡Descubre nuestras opciones en Música, Danza, Artes Plásticas y Teatro! 🎭🎶🎨\n\n1️⃣ Cursos Vacacionales – Actividades artísticas y divertidas para vacaciones o recesos escolares.\n2️⃣ Clases Presenciales – En nuestra sede, con clases individuales o en grupos pequeños.\n3️⃣ Clases Virtuales – Aprende desde casa con clases en vivo o a tu ritmo por nuestra plataforma.\n4️⃣ Clases a Domicilio – Profes en casa. Llevamos el arte hasta tu puerta. 🏠\n5️⃣ Otros Servicios – Alquiler de espacios, tienda de instrumentos, eventos y más.\n\n💬 ¿Cuál opción te gustaría conocer mejor?",
          "options": [
            "Cursos Vacacionales",
            "Clases Presenciales",
            "Clases Virtuales",
            "Clases a Domicilio",
            "Otros Servicios"
          ],
          "waitResponse": true,
          "typeMessage": "text"
        }
      }
    },
    {
      "id": "show_program_options_filter",
      "name": "06 - Ruteo menú opciones (y guardar service)",
      "type": "filter",
      "position": [1660, 0],
      "parameters": {
        "options": {
          "filterConditions": [
            {
              "operator": "contains",
              "value": "vacacional",
              "targetNodeId": "flow_vacacionales",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            },
            {
              "operator": "contains",
              "value": "presencial",
              "targetNodeId": "flow_presencial",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            },
            {
              "operator": "contains",
              "value": "virtual",
              "targetNodeId": "flow_virtual",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            },
            {
              "operator": "contains",
              "value": "domicilio",
              "targetNodeId": "flow_domicilio",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            },
            {
              "operator": "contains",
              "value": "otros",
              "targetNodeId": "flow_otros_servicios",
              "storeResponseInMemory": true,
              "labelInMemory": "service"
            }
          ],
          "filterDefaultCondition": {
            "targetNodeId": "menu_fallback",
            "storeResponseInMemory": true,
            "labelInMemory": "service"
          }
        }
      }
    },
    {
      "id": "menu_fallback",
      "name": "07 - Fallback menú",
      "type": "autobotAction",
      "position": [1900, -120],
      "parameters": {
        "options": {
          "allowFreeText": false,
          "textMessage": "Te entendí a medias 😅 Para ayudarte mejor, elige una opción con los botones:",
          "options": [
            "Cursos Vacacionales",
            "Clases Presenciales",
            "Clases Virtuales",
            "Clases a Domicilio",
            "Otros Servicios"
          ],
          "waitResponse": true,
          "typeMessage": "text"
        }
      }
    },
    {
      "id": "return_to_menu_filter",
      "name": "Return to menu (simple filter)",
      "type": "filter",
      "position": [2380, 280],
      "parameters": {
        "options": {
          "filterConditions": [
            { "operator": "contains", "value": "volver", "targetNodeId": "show_program_options" }
          ],
          "filterDefaultCondition": { "targetNodeId": "show_program_options" }
        }
      }
    }
  ],
  "connections": [
    { "source": "webhook", "target": "ask_name" },
    { "source": "ask_name", "target": "ask_name_filter" },
    { "source": "ask_name_filter", "target": "ask_phone" },
    { "source": "ask_phone", "target": "ask_phone_filter" },
    { "source": "ask_phone_filter", "target": "show_program_options" },

    { "source": "show_program_options", "target": "show_program_options_filter" },
    { "source": "show_program_options", "target": "show_program_options_filter" },
    { "source": "show_program_options", "target": "show_program_options_filter" },
    { "source": "show_program_options", "target": "show_program_options_filter" },
    { "source": "show_program_options", "target": "show_program_options_filter" },

    { "source": "show_program_options_filter", "target": "menu_fallback" },
    { "source": "show_program_options_filter", "target": "flow_vacacionales" },
    { "source": "show_program_options_filter", "target": "flow_presencial" },
    { "source": "show_program_options_filter", "target": "flow_virtual" },
    { "source": "show_program_options_filter", "target": "flow_domicilio" },
    { "source": "show_program_options_filter", "target": "flow_otros_servicios" },

    { "source": "menu_fallback", "target": "show_program_options_filter" },
    { "source": "menu_fallback", "target": "show_program_options_filter" },
    { "source": "menu_fallback", "target": "show_program_options_filter" },
    { "source": "menu_fallback", "target": "show_program_options_filter" },
    { "source": "menu_fallback", "target": "show_program_options_filter" },

    { "source": "menu_fallback", "target": "return_to_menu_filter" }
  ]
}
